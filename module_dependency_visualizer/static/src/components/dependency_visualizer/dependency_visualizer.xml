<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">
    <t t-name="module_dependency_visualizer.DependencyVisualizer">
        <div class="o_action">
            <ControlPanel display="controlPanelDisplay">
                <t t-set-slot="control-panel-always-buttons">
                    <div class="o_cp_buttons" role="toolbar" aria-label="Control panel buttons">
                        <div class="d-inline-block">
                            <button type="button" t-on-click="printPng" class="btn btn-primary" title="Print">Exportar PNG</button>
                        </div>
                    </div>
                </t>
                <t t-set-slot="layout-actions">
                    <div class="o_cp_searchview d-flex input-group" role="search">
                        <div class="o_searchview form-control d-print-contents d-flex align-items-center py-1" role="search" aria-autocomplete="list">
                            <i class="o_searchview_icon d-print-none oi oi-search me-2"
                                role="img"
                                aria-label="Search..."
                                title="Search..."
                            />
                            <div class="o_searchview_input_container d-flex flex-grow-1 flex-wrap gap-1">
                                <input type="text"
                                   class="o_searchview_input o_input d-print-none flex-grow-1 w-auto border-0"
                                   accesskey="Q"
                                   placeholder="Search..."
                                   role="searchbox"
                                   t-att-value="state.searchText"
                                   t-on-keyup="onInputKeyup"
                                />
                            </div>
                        </div>
                        <div class="o-dropdown dropdown o-dropdown--no-caret">
                            <button type="button" t-on-click="clearSearch" class="dropdown-toggle o_searchview_dropdown_toggler d-print-none btn btn-outline-secondary o-no-caret rounded-start-0 h-100" tabindex="0" aria-expanded="false">
                                <i class="fa fa-times o_searchview_clear" aria-hidden="true" data-hotkey="shift+q" title="Borrar búsqueda" style="position: relative;"></i>
                            </button>
                        </div>
                    </div>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <div class="o_dropdown_container o_website_menu w-100 w-lg-auto h-100 px-3 border-start">
                        <div class="px-3 fs-5 mb-2">
                            <i class="me-2 fa fa-cube"/>
                            <h5 class="o_dropdown_title d-inline"><t t-out="state.moduleCount"/> Módulo(s)</h5>
                        </div>
                    </div>
                </t>
            </ControlPanel>
            <div class="o_content o_component_with_search_panel module_graph_main">
                <div class="o_search_panel flex-grow-0 flex-shrink-0 h-100 pb-5 bg-view pe-1 ps-3 module_graph_nav" style="max-height:100% ;">
                    <section class="o_search_panel_section o_search_panel_category">
                        <header class="o_search_panel_section_header pt-4 pb-2 text-uppercase cursor-default">
                            <i class="fa fa-info-circle o_search_panel_section_icon text-odoo me-2"/>
                            <b>All</b>
                        </header>
                        <t t-if="this.nodes">
                            <ul class="list-group d-block o_search_panel_field module_graph_nav_list">
                                <t t-foreach="this.nodes" t-as="node" t-key="node_index">
                                    <li class="o_search_panel_category_value list-group-item py-1 cursor-pointer border-0 pe-0 ps-0"
                                        t-att-data-id="node.id" t-att-data-name="node.label" t-on-click="onClickNavModule">
                                        <header class="list-group-item list-group-item-action d-flex align-items-center px-0 py-lg-0 border-0">
                                            <div class="o_search_panel_label d-flex align-items-center w-100 cursor-pointer mb-0 o_with_counters">
                                                <span class="o_search_panel_label_title text-truncate">
                                                    <strong><t t-esc="node.shortdesc"/></strong>
                                                    <br/><code><t t-esc="node.label"/></code>
                                                </span>
                                            </div>
                                        </header>
                                    </li>
                                </t>
                            </ul>
                        </t>
                    </section>
                </div>
                <div class="o_kanban_renderer o_renderer d-flex o_kanban_ungrouped">
                    <div class="module_legend">
                        <h5>AYUDA:</h5>
                        <ul>
                            <li class="module_legend module_legend_uninstallable">uninstallable</li>
                            <li class="module_legend module_legend_installed">installed</li>
                            <li class="module_legend module_legend_uninstalled">uninstalled</li>
                            <li class="module_legend module_legend_to_install">to install</li>
                            <li class="module_legend module_legend_to_upgrade">to upgrade</li>
                            <li class="module_legend module_legend_to_remove">to remove</li>
                            <li><img src="/module_dependency_visualizer/static/src/img/blue_arrow.png"/><span>Dependencia</span></li>
                            <li><img src="/module_dependency_visualizer/static/src/img/red_arrow.png"/><span>Exclusión</span></li>
                            <li><img class="mouse_img" src="/module_dependency_visualizer/static/src/img/left_click.png"/><span>Información</span></li>
                            <li><img class="mouse_img" src="/module_dependency_visualizer/static/src/img/right_click.png"/><span>Eliminar</span></li>
                        </ul>
                    </div>
                    <div t-ref="mynetwork" class="module_graph"/>
                    <div t-ref="help_info" class="o_view_nocontent" style="margin-right: 132px !important;">
                        <div class="o_nocontent_help">
                            <p class="o_view_nocontent_smiling_face">
                                Seleccione un módulo para ver sus dependencias
                            </p>
                            <p>
                                Gestione las dependencias de sus módulos para garantizar una instalación y funcionamiento correctos.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>